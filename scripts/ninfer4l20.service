[Unit]
Description=NInfer4L20 - Qwen3.8-27B-NInfer inference service (L20 GPU2, 262144 ctx)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lenovo
Environment=CUDA_VISIBLE_DEVICES=2
ExecStart=/opt/Ninfer4L20/src/src/build/apps/ninfer-serve \
  /opt/models/WaveCut/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-DFlash2-NInfer/qwen3_8_27b_hauhaucs_aggressive_dflash2.ninfer \
  --host 127.0.0.1 --port 8002 \
  --model-id Qwen3.8 \
  --max-context 262144 --kv-capacity 262144 \
  --kv-dtype bf16 \
  --spec dflash2 --draft-tokens 7 --lm-head-draft --no-thinking \
  --prefill-chunk 2688 \
  --max-concurrency 1 --max-pending-requests 16 --pending-timeout-ms 600000 \
  --log-level info
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
